{
  "name": "breakcart-server",
  "version": "1.0.0",
  "private": true,
  "description": "BreakCart services: an e-commerce platform built to break on sale day",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/scripts/dev.ts",
    "verify:labs": "tsx src/scripts/verify-labs.ts",
    "gen:docs": "tsx src/scripts/gen-lab-docs.ts",
    "status": "tsx src/scripts/status.ts",
    "probe:ratelimit": "tsx src/scripts/ratelimit-probe.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
